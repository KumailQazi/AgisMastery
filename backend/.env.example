# Core Application
APP_ENV=development
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Databases & Cache
DATABASE_URL=postgresql+psycopg2://mastery_user:mastery_pass@localhost:5432/mastery_db
REDIS_URL=redis://localhost:6379/0
USE_FIRESTORE=false

# Google AI Core (Gemini 3.5 & ADK)
GEMINI_API_KEY=your-gemini-api-key-here
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Google Model Armor (PII Sanitization)
MODEL_ARMOR_ENABLED=true
MODEL_ARMOR_TEMPLATE_ID=mastery-pii-template

# Extra Google Models (Stage 3 Bonus Points)
GEMMA_DEPLOYMENT_MODE=ollama
OLLAMA_HOST=http://localhost:11434
GEMMA_MODEL=gemma2:9b
VEO_API_KEY=your-veo-api-key-here
LYRIA_API_KEY=your-lyria-api-key-here

# Async Tasks
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
